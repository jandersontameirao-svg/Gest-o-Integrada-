{
  "name": "grupo-arqueo-gestao-integrada",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --env-file=.env --experimental-strip-types server/index.ts",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "test": "node --test tests/core.test.ts tests/governance-policy.test.ts tests/strategy.test.ts tests/consolidation.test.ts tests/contracts.test.ts",
    "test:integration": "node --env-file=.env --test tests/api.test.ts",
    "migrate": "node --env-file=.env scripts/migrate.ts",
    "seed": "node --env-file=.env scripts/seed.ts",
    "start": "node --env-file=.env server/index.ts",
    "test:e2e": "E2E_OUTPUT_DIR=test-results/contracts PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-report/contracts playwright test tests/browser/contracts.spec.ts && E2E_OUTPUT_DIR=test-results/strategy PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-report/strategy playwright test tests/browser/strategy.spec.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mysql2": "^3.15.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.2.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "lucide-react": "^0.453.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "@tailwindcss/vite": "^4.1.14",
    "@playwright/test": "^1.56.1"
  }
}
