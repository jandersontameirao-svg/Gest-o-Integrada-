{
  "name": "grupo-arqueo-gestao-integrada",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --env-file=.env --experimental-strip-types server/index.ts",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "test": "node --test tests/core.test.ts tests/governance-policy.test.ts",
    "test:integration": "node --env-file=.env --test tests/api.test.ts",
    "migrate": "node --env-file=.env scripts/migrate.ts",
    "seed": "node --env-file=.env scripts/seed.ts",
    "start": "node --env-file=.env server/index.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mysql2": "^3.15.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "@vitejs/plugin-react": "^5.0.4"
  }
}
