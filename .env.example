NODE_ENV=development
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=arqueo_demo
DB_USER=arqueo_app
DB_PASSWORD=replace-locally
# Necessário somente para seed explícito; use senha sintética forte (mínimo 16 caracteres).
DEMO_PASSWORD=


# Arquivos privados de fornecedores: padrão 2 MiB, máximo técnico 8 MiB
SUPPLIER_ATTACHMENT_MAX_BYTES=2097152
